{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers Builds defaults (`npm run build` then `npx wrangler deploy`)
  // work because package.json "build" runs OpenNext, which writes .open-next/.
  "main": ".open-next/worker.js",
  "name": "forcesportsunited",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
